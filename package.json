{
  "name": "gym-hero",
  "version": "1.0.0",
  "private": true,
  "description": "Gym Hero: дневник тренировок (PWA на Cloudflare Pages + D1)",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public --project-name gym-hero --branch master",
    "db:migrate:local": "wrangler d1 migrations apply looneyhome_database --local",
    "db:migrate": "wrangler d1 migrations apply looneyhome_database --remote",
    "db:backup": "wrangler d1 export looneyhome_database --remote --output ~/d1-backups/looneyhome_database-$(date +%F).sql"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
