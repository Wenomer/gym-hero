{
  "name": "gym-hero",
  "version": "1.0.0",
  "private": true,
  "description": "Gym Hero: дневник тренировок (PWA на Cloudflare Pages + D1)",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public --project-name gym-hero --branch master",
    "db:schema": "wrangler d1 execute gym-hero --remote --file=schema.sql",
    "db:schema:local": "wrangler d1 execute gym-hero --local --file=schema.sql",
    "db:backup": "wrangler d1 export gym-hero --remote --output=gym-hero-backup.sql"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
